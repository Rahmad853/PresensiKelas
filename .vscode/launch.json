{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Jalankan Server Lokal",
            "type": "python",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "args": [
                "-m",
                "uvicorn",
                "main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}